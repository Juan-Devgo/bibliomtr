# Plantilla de configuración de producción (spec 005). Copiar a `.env` (fuera de git) y
# reemplazar todo valor que empiece con CAMBIAR_. Sin comillas ni espacios alrededor del `=`.

# Base de datos RDS (PostgreSQL con la extensión vector). sslmode=require cifra la conexión.
SPRING_DATASOURCE_URL=jdbc:postgresql://CAMBIAR_ENDPOINT_RDS:5432/bibliomtr?sslmode=require
SPRING_DATASOURCE_USERNAME=CAMBIAR_USUARIO_MAESTRO
SPRING_DATASOURCE_PASSWORD=CAMBIAR_CONTRASENA

# Ruta dentro del contenedor `api`; se monta en solo lectura desde ./corpus del host.
BIBLIOMTR_CORPUS_DIR=/data/corpus
BIBLIOMTR_OLLAMA_URL=http://ollama:11434

# Dominio y correo para HTTPS con Let's Encrypt. DOMAIN vacío = solo HTTP.
DOMAIN=tu-dominio.example
CERTBOT_EMAIL=CAMBIAR_correo@tu-dominio.example
# 1 = entorno de pruebas de Let's Encrypt (certificados no confiables); 0 = producción.
CERTBOT_STAGING=0
